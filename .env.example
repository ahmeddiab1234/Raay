# MLflow tracking store. Local dev: sqlite:///mlflow.db (or file:./mlruns).
MLFLOW_TRACKING_URI=
# Required by MLflow >= 3 for `file:` tracking URIs; harmless for sqlite.
MLFLOW_ALLOW_FILE_STORE=true
# Basic auth for a remote (Dagshub) MLflow server; leave blank for local stores.
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# Dagshub. The DVC remote creds live in .dvc/config.local (git-ignored) because
# DVC only reads `user`/`password` from its own config, not the environment.
# CI supplies the same token as the DAGSHUB_TOKEN repository secret.
DAGSHUB_USER=
DAGSHUB_TOKEN=

# Kaggle training session
# Dir containing the processed train.csv/val.csv/test.csv snapshot.
DATA_ROOT=
# Legacy alias for DATA_ROOT (preferred).
KAGGLE_DATA_DIR=
# Dir containing the teacher checkpoint (config.json + weights) for distillation.
KAGGLE_TEACHER_DIR=

# --- Staging deployment (GitHub Actions, not local processes) ----------------
# The CD deploy job reads these from the GitHub `staging` *environment*, not from
# this file; they are listed here so the required set is discoverable in one
# place. Host/user/port are better as environment variables; the key and the
# registry token must be secrets.
#
# STAGING_SSH_HOST / STAGING_SSH_USER / STAGING_SSH_PORT
#     Address of the staging box and the deploy user. Defaults to port 22.
# STAGING_SSH_PRIVATE_KEY
#     Secret: the deploy user's private key. The account needs no sudo, only
#     write access to /opt/raay-staging (tools) and /var/lib/raay-staging
#     (state + the short-lived registry token).
# STAGING_GHCR_TOKEN
#     Secret: a PAT with read:packages on the private ghcr.io package. Only
#     needed because the image is private; the runner's GITHUB_TOKEN is not
#     sent to the host.
STAGING_SSH_HOST=
STAGING_SSH_USER=
STAGING_SSH_PORT=22
STAGING_SSH_PRIVATE_KEY=
STAGING_GHCR_TOKEN=
