# Every environment variable this project reads, by name only -- no values.
#
# The 3-command quickstart in the README needs NONE of them: the serving
# assets are fetched anonymously (scripts/fetch_assets.py), MLflow runs against
# a local SQLite store, and the model graph is read from the working tree.
# Everything below is for the optional paths: a remote tracking server, the
# DVC remote, a container release, the retrain dispatch, the feedback sidecar.

# --- MLflow tracking --------------------------------------------------------
# Local dev: sqlite:///mlflow.db (or file:./mlruns). No server, no account.
MLFLOW_TRACKING_URI=
# Required by MLflow >= 3 for `file:` tracking URIs; harmless for sqlite.
MLFLOW_ALLOW_FILE_STORE=true
# Basic auth for a REMOTE tracking server (Dagshub). Leave blank for local stores.
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# --- Dagshub / DVC remote (optional) ---------------------------------------
# Only needed to pull the full DVC history from our namespace (e.g. the 212 MB
# EDA corpus). DVC reads these from .dvc/config.local, not from the
# environment; the names are the same as the CI repository secrets.
DAGSHUB_USER=
DAGSHUB_TOKEN=

# --- Asset bootstrap (optional) --------------------------------------------
# Base URL of the public release that scripts/fetch_assets.py pulls the
# DVC-tracked objects from. Override to use a mirror.
RAAY_ASSETS_URL=

# --- Serving ----------------------------------------------------------------
# Explicit ONNX graph override. Unset -> resolve models:/ArabicSentiment/Production
# from the MLflow registry, which needs a reachable tracking server.
RAAY_ONNX_PATH=
# Tokenizer + id2label source.
RAAY_TOKENIZER_DIR=
# Tokenizer truncation length.
RAAY_MAX_LENGTH=
# HuggingFace encoder id used for the engineered drift features.
RAAY_MODEL_NAME=
# Version stamp echoed by /health and /predict (baked into the image at build time).
RAAY_MODEL_VERSION=
# MLflow registered model name and alias resolved at worker start.
RAAY_REGISTERED_MODEL=
RAAY_ALIAS=

# --- Telemetry (optional) ---------------------------------------------------
# Active only when BOTH are set; unset = the middleware is inert.
RAAY_TELEMETRY_URL=
RAAY_WORKER=

# --- Canary agent (optional) ------------------------------------------------
RAAY_AGENT_PAIR_TTL=
RAAY_AGENT_MAX_PAIRS=

# --- Customer-service feedback sidecar -------------------------------------
# The service REFUSES to start without a token: an unauthenticated endpoint
# that writes into the training corpus is a poisoning vector. Set
# RAAY_FEEDBACK_ALLOW_ANON=1 for a local/test run only.
RAAY_FEEDBACK_TOKEN=
RAAY_FEEDBACK_TOKEN_FILE=
RAAY_FEEDBACK_ALLOW_ANON=
# Directory the sidecar appends raw captures to.
RAAY_FEEDBACK_DIR=

# --- Retrain dispatch (optional) -------------------------------------------
# Fine-grained PAT for repository_dispatch; needs Contents: read and write on
# the target repo (a read-only token is rejected). Prefer the file variant.
RAAY_GITHUB_DISPATCH_TOKEN=
RAAY_GITHUB_DISPATCH_TOKEN_FILE=
# Target owner/repo for the dispatch.
RAAY_GITHUB_REPOSITORY=

# --- Images and release deployment -----------------------------------------
# Image tag a release deploy pulls (pin a commit sha, never `latest`).
RAAY_IMAGE=
# Registry token used by scripts/deploy_staging.py to log in to the registry.
RAAY_REGISTRY_TOKEN=

# --- Staging deployment (GitHub Actions `staging` environment, not local) --
# The CD deploy job reads these from the GitHub `staging` *environment*, not from
# this file; they are listed here so the required set is discoverable in one
# place. Host/user/port are better as environment variables; the key and the
# registry token must be secrets.
#
# STAGING_SSH_HOST / STAGING_SSH_USER / STAGING_SSH_PORT
#     Address of the staging box and the deploy user. Defaults to port 22.
# STAGING_SSH_PRIVATE_KEY
#     Secret: the deploy user's private key. The account needs no sudo, only
#     write access to /opt/raay-staging (tools) and /var/lib/raay-staging
#     (state + the short-lived registry token).
# STAGING_GHCR_TOKEN
#     Secret: a PAT with read:packages on the private ghcr.io package. Only
#     needed because the image is private; the runner's GITHUB_TOKEN is not
#     sent to the host.
STAGING_SSH_HOST=
STAGING_SSH_USER=
STAGING_SSH_PORT=22
STAGING_SSH_PRIVATE_KEY=
STAGING_GHCR_TOKEN=

# --- Kaggle training session (optional) ------------------------------------
# Dir containing the processed train.csv/val.csv/test.csv snapshot.
DATA_ROOT=
# Legacy alias for DATA_ROOT (preferred).
KAGGLE_DATA_DIR=
# Dir containing the teacher checkpoint (config.json + weights) for distillation.
KAGGLE_TEACHER_DIR=
